{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-render-manifest.schema.json",
  "title": "Media Render Manifest",
  "type": "object",
  "required": ["content_id", "project_id", "aspect_ratio", "fps", "scenes", "output"],
  "properties": {
    "content_id": {"type": "string"},
    "project_id": {"type": "string"},
    "aspect_ratio": {"enum": ["9:16", "16:9", "1:1"]},
    "fps": {"type": "number", "minimum": 1},
    "flow_status": {"enum": ["ACTIVE", "HOLD", "NOT_VERIFIED", "BYPASSED"]},
    "renderer": {"type": "string"},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "duration_ms"],
        "properties": {
          "scene_id": {"type": "string"},
          "cut_id": {"type": "string"},
          "duration_ms": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "subtitle": {"type": "string"},
          "asset_url": {"type": ["string", "null"]},
          "asset_type": {"enum": ["image", "video", "canvas", "kinetic", "placeholder"]},
          "source": {"type": "string"},
          "flow_replaceable": {"type": "boolean"}
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "tts_url": {"type": ["string", "null"]},
        "bgm_url": {"type": ["string", "null"]},
        "subtitle_track": {"type": ["string", "null"]}
      }
    },
    "output": {
      "type": "object",
      "required": ["container", "codec", "filename"],
      "properties": {
        "container": {"enum": ["mp4", "webm", "gif"]},
        "codec": {"type": "string"},
        "filename": {"type": "string"},
        "drive_target": {"type": ["string", "null"]}
      }
    }
  }
}
