{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation Pack Hymn Simple Image/Video Input",
  "type": "object",
  "required": [
    "title",
    "tuneId",
    "defaultLanguage",
    "languages"
  ],
  "properties": {
    "hymnNo": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 645
    },
    "songId": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "tuneId": {
      "type": "string"
    },
    "defaultLanguage": {
      "type": "string"
    },
    "backgroundImageUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "audioUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "motion": {
      "enum": [
        "NONE",
        "SLOW_ZOOM",
        "SLOW_PAN"
      ]
    },
    "qa": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "melodyFirstGate": {
          "enum": [
            "PASS",
            "HOLD",
            "PENDING"
          ]
        },
        "musicTeacherPatternTemplate": {
          "enum": [
            "PASS",
            "HOLD",
            "PENDING"
          ]
        }
      }
    },
    "visualPlaylist": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "start",
          "end",
          "kind",
          "asset_url"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "asset_url": {
            "type": "string"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "crossfade_sec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "loop": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "motion": {
            "enum": [
              "NONE",
              "SLOW_ZOOM",
              "SLOW_PAN"
            ]
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "rightsStatus",
          "lines"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "rightsStatus": {
            "enum": [
              "PUBLIC_DOMAIN",
              "CC0",
              "CC_BY",
              "CC_BY_SA",
              "EXPLICIT_LICENSE",
              "USER_PROVIDED",
              "COPYRIGHTED_METADATA_ONLY",
              "UNKNOWN_METADATA_ONLY"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "text"
              ],
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}